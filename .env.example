# ==============================================================================
# NETWORK INVESTIGATOR ENVIRONMENT CONFIGURATION
# ==============================================================================

# Fast API Backend
PORT=8000
HOST=0.0.0.0

# Real-Time Database (Supabase PostgreSQL / Built-in SQLite)
# If left empty, the application automatically uses the high-performance async SQLite engine
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=sqlite+aiosqlite:///data/network_investigator.db

# AI Forensic Engine (Optional LLM Integration)
# If AI_API_KEY is empty, the application uses its built-in deterministic telecom causal engine
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# Correlation Engine Parameters
TEMPORAL_WINDOW_SECONDS=300
CORRELATION_CONFIDENCE_THRESHOLD=0.65
AUTO_INCIDENT_MIN_EVENTS=3
SIMULATION_TICK_INTERVAL_MS=2500
